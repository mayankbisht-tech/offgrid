# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (server-only, never prefix with NEXT_PUBLIC_)
DATABASE_URL="postgresql://user:password@host:5432/offgrid?sslmode=require"

# ─── APP ───────────────────────────────────────────────────────────────────────
# Public app URL — used for CORS, OAuth callbacks, email links
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="OffGrid"

# ─── CLOUDINARY ────────────────────────────────────────────────────────────────
# Server-only: used in signed upload / admin operations
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Public: safe for frontend upload widget / unsigned uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="offgrid_designs"   # unsigned upload preset

# ─── RAZORPAY ──────────────────────────────────────────────────────────────────
# Server-only secret — NEVER expose RAZORPAY_KEY_SECRET to client
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
# Public: used in frontend Razorpay checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ─── STRIPE ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# ─── RESEND (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@offgrid.store"

# ─── GEMINI AI ─────────────────────────────────────────────────────────────────
# Server-only: proxied through /api/generate — never sent to client
GEMINI_API_KEY="your-gemini-api-key"
