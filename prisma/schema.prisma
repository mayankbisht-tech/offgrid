generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  role      String
  username  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("offgrid_users")
}
